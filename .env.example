# Copy to .env. Every default here is safe and free — the app runs with none of the keys filled in.

# Posting is PER-USER: each person enters their own Proof token on the portal (Account page),
# and their logs post to their own record. The app never posts with a server/owner token, so
# there is no PROOF_TOKEN here. Without a connected token, a log is just drafted (never posted).
PROOF_BASE=https://proof.zeromaintenanceengineer.in

# Speech-to-text: browser | groq | faster_whisper
STT_PROVIDER=browser
GROQ_API_KEY=

# Follow-up question generator: rule | groq | gemini
LLM_PROVIDER=rule
GEMINI_API_KEY=

# Text-to-speech: browser | edge | elevenlabs
TTS_PROVIDER=browser
# ElevenLabs (TTS_PROVIDER=elevenlabs): best quality + multilingual (Tamil). Free tier available.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_multilingual_v2

# Default conversation language: en | ta  (the UI can override per session)
DEFAULT_LANG=en
